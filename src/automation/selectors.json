{
  "claude": {
    "inputType": "contenteditable",
    "inputSelectors": [
      "[data-testid='chat-input'] div.ProseMirror[contenteditable='true']",
      "div.ProseMirror[contenteditable='true']",
      "div[contenteditable='true']"
    ],
    "sendSelectors": [
      "[data-testid='chat-input-send']"
    ],
    "responseSelectors": [
      "[data-testid='transcript-row'] [role='article']"
    ],
    "responseContainerSelectors": [
      "[data-testid='transcript-list']"
    ]
  },
  "grok": {
    "inputType": "contenteditable",
    "inputSelectors": [
      "div.ProseMirror[contenteditable='true'][aria-label='Ask Grok anything']",
      "div.ProseMirror[contenteditable='true']",
      "div[contenteditable='true']"
    ],
    "sendSelectors": [
      "button[data-testid='chat-submit']",
      "button[aria-label='Submit']",
      "button[type='submit']"
    ],
    "responseSelectors": [
      "[data-testid='assistant-message']"
    ],
    "responseContainerSelectors": [
      "[data-testid='drop-container']"
    ]
  },
  "gemini": {
    "inputType": "contenteditable",
    "inputSelectors": [
      "div.ql-editor[role='textbox']",
      "div.ql-editor[contenteditable='true']",
      "div[contenteditable='true'][role='textbox']"
    ],
    "sendSelectors": [
      "button[aria-label='Send message']",
      "button[aria-label='Submit']"
    ],
    "responseSelectors": [
      ".model-response-text",
      "message-content",
      "[data-message-id] .markdown",
      ".response-container .markdown",
      ".conversation-container model-response",
      "model-response"
    ],
    "responseContainerSelectors": [
      "[class*='response-container']",
      ".conversation-container"
    ]
  }
}
